generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum AttributeType {
  DROPDOWN
  RADIO
  CHECKBOX
  COLOR_SWATCH
  IMAGE_SWATCH
}

enum StockStatus {
  IN_STOCK
  OUT_OF_STOCK
}

model PermissionGroup {
  id          String       @id @default(uuid())
  name        String       @unique
  slug        String       @unique
  description String?
  permissions Permission[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  action      String
  description String?
  groupId     String
  group       PermissionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([groupId, action])
  @@index([groupId])
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  active      Boolean          @default(true)
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  phone        String?
  gender       Gender?
  avatarId     String?
  avatar       Media?       @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  active       Boolean      @default(true)
  sessions     Session[]
  uploads      Media[]      @relation("MediaUploader")
  auditLogs    AuditLog[]   @relation("AuditActor")
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([roleId])
}

model Session {
  id        String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  replacedById String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

model Media {
  id            String                 @id @default(uuid())
  fileName      String
  originalName  String
  storedPath    String
  publicUrl     String
  mimeType      String
  type          MediaType
  size          Int
  width         Int?
  height        Int?
  thumbnailPath String?
  thumbnailUrl  String?
  altText       String?
  title         String?
  uploadedById  String
  uploadedBy    User                   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  userAvatars   User[]                 @relation("UserAvatar")
  categories    Category[]             @relation("CategoryImage")
  brands        Brand[]                @relation("BrandLogo")
  attributeValues AttributeValue[]     @relation("AttributeValueMedia")
  productMedia  ProductMedia[]
  variantMedia  VariantMedia[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([uploadedById])
  @@index([type])
}

model Category {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  description String?
  imageId     String?
  image       Media?            @relation("CategoryImage", fields: [imageId], references: [id], onDelete: SetNull)
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]        @relation("CategoryTree")
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  products    ProductCategory[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([parentId])
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logoId      String?
  logo        Media?    @relation("BrandLogo", fields: [logoId], references: [id], onDelete: SetNull)
  active      Boolean   @default(true)
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Attribute {
  id        String          @id @default(uuid())
  name      String          @unique
  slug      String          @unique
  type      AttributeType
  values    AttributeValue[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model AttributeValue {
  id          String                  @id @default(uuid())
  attributeId String
  attribute   Attribute               @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  slug        String
  reference   String?
  mediaId     String?
  media       Media?                  @relation("AttributeValueMedia", fields: [mediaId], references: [id], onDelete: SetNull)
  variants    VariantAttributeValue[]
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@unique([attributeId, value])
  @@unique([attributeId, slug])
  @@index([attributeId])
}

model Product {
  id               String            @id @default(uuid())
  name             String
  slug             String            @unique
  sku              String?           @unique
  shortDescription String?
  longDescription  String?
  hasVariants      Boolean           @default(false)
  price            Decimal?          @db.Decimal(12, 2)
  salePrice        Decimal?          @db.Decimal(12, 2)
  stock            Int?
  stockStatus      StockStatus
  weight           Decimal?          @db.Decimal(10, 3)
  active           Boolean           @default(true)
  featured         Boolean           @default(false)
  sortOrder        Int               @default(0)
  brandId          String?
  brand            Brand?            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  categories       ProductCategory[]
  media            ProductMedia[]
  variants         ProductVariant[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([brandId])
  @@index([active])
  @@index([name])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductMedia {
  productId   String
  mediaId     String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media       Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  isThumbnail Boolean @default(false)
  isGallery   Boolean @default(true)
  sortOrder   Int     @default(0)

  @@id([productId, mediaId])
  @@index([mediaId])
}

model ProductVariant {
  id                String                  @id @default(uuid())
  productId         String
  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String                  @unique
  price             Decimal                 @db.Decimal(12, 2)
  salePrice         Decimal?                @db.Decimal(12, 2)
  stock             Int
  stockStatus       StockStatus
  lowStockThreshold Int                     @default(5)
  weight            Decimal?                @db.Decimal(10, 3)
  active            Boolean                 @default(true)
  values            VariantAttributeValue[]
  media             VariantMedia[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([productId])
}

model VariantAttributeValue {
  variantId       String
  attributeValueId String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValue  AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Restrict)

  @@id([variantId, attributeValueId])
  @@index([attributeValueId])
}

model VariantMedia {
  variantId   String
  mediaId     String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  media       Media          @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  isThumbnail Boolean        @default(false)
  sortOrder   Int            @default(0)

  @@id([variantId, mediaId])
  @@index([mediaId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entity     String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entity, entityId])
}
